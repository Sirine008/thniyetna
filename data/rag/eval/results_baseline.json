      "id": "q01",
      "lang": "fr",
      "answerable": true,
      "question": "Qu'est-ce qu'un nid-de-poule et quelles sont les causes de sa formation ?",
      "latency_ms": 70225,
      "sources": [
        {
          "n": 1,
          "title": "GUIDE-de-bonnes-pratiques-de-reparation-de-nids-de-poule",
