{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Route",
  "description": "Contract produced by M3, consumed by M4.",
  "type": "object",
  "required": ["route_id", "status", "polyline", "score"],
  "properties": {
    "route_id": { "type": "string" },
    "status": { "type": "string", "enum": ["on_official_route", "rerouted"] },
    "risk": { "type": "number" },
    "polyline": {
      "type": "array",
      "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
    },
    "score": { "type": "number" },
    "reason": { "type": "string" }
  }
}
