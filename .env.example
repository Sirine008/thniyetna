POSTGRES_DB=thniyetna
POSTGRES_USER=thniyetna
POSTGRES_PASSWORD=thniyetna_dev
POSTGRES_PORT=5432

API_PORT=8000
WEB_PORT=8081
OSRM_PORT=5002
MLFLOW_PORT=5000

JWT_SECRET=replace-with-a-long-random-secret
BOOTSTRAP_PASSWORD=Thniyetna2026!
APP_ENV=development
LOG_LEVEL=INFO

# M1 inference
M1_MODEL_FILE=road-damage-yolo26s.pt
M1_MODEL_NAME=yolo26s-rdd2022-dronefreak
M1_DEVICE=cpu
M1_IMGSZ=640
M1_CONF=0.25
M1_IOU=0.50
M1_VIDEO_FPS=5
M1_BATCH_SIZE=8
M1_DEDUP_RADIUS_M=20
M1_DEDUP_DAYS=14

# RAG assistant (Ollama on the Windows host; the api container reaches it via host.docker.internal)
OLLAMA_URL=http://host.docker.internal:11434
RAG_LLM_MODEL=llama3.2:3b
RAG_EMBED_MODEL=nomic-embed-text
# Quality options, measured in docs/RAG_EVALUATION.md (python -m rag.evaluate).
# RAG_BILINGUAL=true: also search the question translated fr<->en (fused with RRF).
# RAG_PROMPT_VERSION=v2: partial answers allowed, refuse only if no source is related (v1 = part A prompt).
# RAG_NUMBERS_RULE=true: copy numbers, units and comparison signs exactly as in the source.
# RAG_FTS_CONFIG=french: full-text search with French stemming (Alembic 0005).
# RAG_CHUNK_CONTEXT=true: search on title + heading + text (Alembic 0006, then `python -m rag.ingest --contexts`).
# RAG_MIN_SIMILARITY>0: refuse without calling the LLM when the best vector match is below it.
RAG_BILINGUAL=false
RAG_PROMPT_VERSION=v2
RAG_NUMBERS_RULE=true
RAG_FTS_CONFIG=simple
RAG_CHUNK_CONTEXT=false
RAG_MIN_SIMILARITY=0
